 ; VMRUN - 启动 Guest（用于外部调用）
 PUBLIC AsmSvmVmrun
 AsmSvmVmrun PROC
     mov     rax, rcx        ; VMCB 物理地址
-    sti
     vmrun   rax
-    cli
     ret

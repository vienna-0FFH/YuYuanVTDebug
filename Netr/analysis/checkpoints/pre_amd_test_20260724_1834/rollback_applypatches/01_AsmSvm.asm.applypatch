     ; === 保存 XMM0-XMM15 ===
     ; movaps 需要 16 字节对齐：sub XMM_SAVE_TOTAL（108h，mod 16 == 8）→ RSP mod 16 == 0
     sub     rsp, XMM_SAVE_TOTAL
     movaps  xmmword ptr [rsp + 0],   xmm0
@@

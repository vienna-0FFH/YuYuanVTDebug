-static __forceinline BOOLEAN
-NptHookpArmGuestSingleStepState(
-    _In_ PVCPU_DATA VcpuData,
-    _In_ LONG Owner,
-    _Out_ PBOOLEAN GuestTfWasSet,
-    _Out_ PUCHAR SavedSvmInterruptState,
-    _Out_ PULONG SavedExceptionIntercepts)
-{
-    ULONG64 rflags = VcpuData->Vmcb->StateSaveArea.Rflags;
-    ULONG64 vintr = VcpuData->Vmcb->ControlArea.VIntr;
-    UCHAR savedInterruptState;
-
-    if (Owner != NPT_SVM_STEP_OWNER_DEBUG &&
-        Owner != NPT_SVM_STEP_OWNER_HOOK) {
-        return FALSE;
-    }
-    if (InterlockedCompareExchange(
-            &VcpuData->SvmSingleStepBlockInterrupts,
-            Owner,
-            NPT_SVM_STEP_OWNER_NONE) != NPT_SVM_STEP_OWNER_NONE) {
-        return FALSE;
-    }
-
-    *GuestTfWasSet = (rflags & NPT_GUEST_RFLAGS_TF) != 0;
-    *SavedExceptionIntercepts =
-        VcpuData->Vmcb->ControlArea.InterceptExceptions;
-
-    savedInterruptState = (UCHAR)(vintr & NPT_SVM_VTPR_MASK);
-    if ((vintr & NPT_SVM_VINTR_MASKING_MASK) != 0) {
-        savedInterruptState |= NPT_SVM_SAVED_VINTR_MASKING;
-    } else {
-        /* Keep guest RFLAGS.IF unchanged.  With V_INTR_MASKING enabled,
-         * VMRUN captures host IF as the physical-IRQ gate, while guest CR8
-         * moves through V_TPR for the duration of this owned TF window. */
-        vintr &= ~NPT_SVM_VTPR_MASK;
-        vintr |= __readcr8() & NPT_SVM_VTPR_MASK;
-        vintr |= NPT_SVM_VINTR_MASKING_MASK;
-    }
-    if ((VcpuData->Vmcb->ControlArea.InterceptMisc1 &
-         SVM_INTERCEPT_INTR) != 0) {
-        savedInterruptState |= NPT_SVM_SAVED_INTR_INTERCEPT;
-    }
-    if ((VcpuData->Vmcb->ControlArea.InterceptMisc1 &
-         SVM_INTERCEPT_NMI) != 0) {
-        savedInterruptState |= NPT_SVM_SAVED_NMI_INTERCEPT;
-    }
-    *SavedSvmInterruptState = savedInterruptState;
-
-    VcpuData->Vmcb->ControlArea.VIntr = vintr;
-    VcpuData->Vmcb->ControlArea.InterceptMisc1 |=
-        (ULONG)(SVM_INTERCEPT_INTR | SVM_INTERCEPT_NMI);
-    VcpuData->Vmcb->StateSaveArea.Rflags = rflags | NPT_GUEST_RFLAGS_TF;
-    VcpuData->Vmcb->ControlArea.InterceptExceptions =
-        NPT_ALL_EXCEPTION_INTERCEPTS;
-    VcpuData->Vmcb->ControlArea.VmcbCleanBits = 0;
-    KeMemoryBarrier();
-    return TRUE;
-}
-
-static __forceinline BOOLEAN
-NptHookpRestoreGuestSingleStepState(
-    _In_ PVCPU_DATA VcpuData,

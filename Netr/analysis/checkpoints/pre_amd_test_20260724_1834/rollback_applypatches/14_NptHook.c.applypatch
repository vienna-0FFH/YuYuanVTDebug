-    (void)NptHookpRestoreGuestSingleStepState(
-        VcpuData,
-        NPT_SVM_STEP_OWNER_DEBUG,
-        stepCpu->GuestTfWasSet,
-        stepCpu->SavedSvmInterruptState,
-        stepCpu->SavedExceptionIntercepts);
-    VcpuData->Vmcb->ControlArea.TlbControl = SVM_TLB_CONTROL_FLUSH_GUEST;
-
-    if (stepCpu->Deliver && stepCpu->Entry) {
-        (void)InterlockedCompareExchange(
-            &stepCpu->Entry->State,
-            NPT_DEBUG_STEP_ARMED,
-            NPT_DEBUG_STEP_COMPLETING);
-    }
-
-    stepCpu->Deliver = FALSE;
-    stepCpu->GuestTfWasSet = FALSE;
-    stepCpu->SavedSvmInterruptState = 0;
-    stepCpu->SavedExceptionIntercepts = 0;
-    stepCpu->TargetPte = NULL;
-    stepCpu->TrapPteValue = 0;
-    stepCpu->Entry = NULL;
-    KeMemoryBarrier();
-    InterlockedExchange(&stepCpu->Active, 0);
-    return TRUE;
-}

 #define NPT_DEBUG_STEP_FREE 0
 #define NPT_DEBUG_STEP_ARMED 1
 #define NPT_DEBUG_STEP_COMPLETING 2
 #define NPT_DEBUG_STEP_COMPLETED 3
 
-#define NPT_GUEST_RFLAGS_TF              0x100ULL
-#define NPT_ALL_EXCEPTION_INTERCEPTS     0xFFFFFFFFu
-#define NPT_DR6_BS_MASK                  (1ULL << 14)
-#define NPT_DR6_NON_SYNTHETIC_CAUSE_MASK 0xB00FULL
-#define NPT_SVM_VTPR_MASK                0xFULL
-#define NPT_SVM_VINTR_MASKING_MASK       (1ULL << 24)
-#define NPT_SVM_SAVED_VINTR_MASKING      0x10u
-#define NPT_SVM_SAVED_INTR_INTERCEPT     0x20u
-#define NPT_SVM_SAVED_NMI_INTERCEPT      0x40u
-#define NPT_SVM_STEP_OWNER_NONE          0
-#define NPT_SVM_STEP_OWNER_DEBUG         1
-#define NPT_SVM_STEP_OWNER_HOOK          2

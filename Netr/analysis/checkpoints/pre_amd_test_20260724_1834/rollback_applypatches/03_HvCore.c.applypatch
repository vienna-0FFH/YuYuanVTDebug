         else if (cpuVendor == CPU_VENDOR_AMD) {
             result = AsmVmmcallWithResult(1);
         }
-        else {
-            s_LastHealthProbeReason = HvHealthProbeUnsupportedVendor;
-            return FALSE;
-        }
-
-        s_LastHealthProbeResult = result;
         

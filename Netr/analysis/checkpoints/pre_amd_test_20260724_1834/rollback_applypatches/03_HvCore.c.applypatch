-
-        s_LastHealthProbeReason = HvHealthProbeUnexpectedResult;
     }
     __except (EXCEPTION_EXECUTE_HANDLER) {
-        s_LastHealthProbeException = GetExceptionCode();
-        s_LastHealthProbeReason = HvHealthProbeException;
         HvInvalidateCurrentProcessorVirtualization();
     }
     
     return FALSE;

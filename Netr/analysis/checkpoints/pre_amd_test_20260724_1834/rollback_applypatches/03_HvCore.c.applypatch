-
-    s_SvmStartup.Cpu[processor].SsSelector = SsSelector;
-    s_SvmStartup.Cpu[processor].SsAccessRights = SsAccessRights;
-    s_SvmStartup.Cpu[processor].SsVmcbAttributes = SsVmcbAttributes;
-    s_SvmStartup.Cpu[processor].SsFlags = SsFlags;
-    KeMemoryBarrier();
-}
-
-VOID HvSvmStartupRecordException(
-    _In_ ULONG RequestedProcessor,
-    _In_ ULONG ActualProcessor,
-    _In_ NTSTATUS ExceptionCode)
-{
-    PHV_SVM_CPU_STARTUP_DIAGNOSTIC record = NULL;
-    ULONG failurePhase = (ULONG)HvSvmStartPhaseException;
-
-    if (RequestedProcessor < s_SvmStartup.RecordCount) {
-        record = &s_SvmStartup.Cpu[RequestedProcessor];
-        if (record->LastPhase != HvSvmStartPhaseNone) {
-            failurePhase = record->LastPhase;
-        }
-        if (record->FailurePhase == HvSvmStartPhaseNone) {
-            record->FailurePhase = failurePhase;
-            record->FailureStatus = ExceptionCode;
-        }
-        record->ExceptionCode = (ULONG)ExceptionCode;
-    }
-
-    if (s_SvmStartup.FirstFailureCpu == MAXULONG) {
-        s_SvmStartup.FirstFailureCpu = RequestedProcessor;
-        s_SvmStartup.FirstFailurePhase = failurePhase;
-        s_SvmStartup.FirstFailureStatus = ExceptionCode;
-        s_SvmStartup.FirstFailureException = (ULONG)ExceptionCode;
-    }
-
-    HvSvmStartupRecord(
-        RequestedProcessor,
-        ActualProcessor,
-        HvSvmStartPhaseException,
-        ExceptionCode,
-        FALSE);
-    KeMemoryBarrier();
-}
 

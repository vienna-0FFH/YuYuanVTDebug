+fn svm_phase_name(phase: u32) -> &'static str {
+    match phase {
+        0 => "none",
+        1 => "affinity-requested",
+        2 => "affinity-bound",
+        3 => "affinity-mismatch",
+        4 => "entered",
+        5 => "svm-enable-begin",
+        6 => "svme-enabled",
+        7 => "host-save-allocated",
+        8 => "vmcb-allocated",
+        9 => "msrpm-allocated",
+        10 => "exit-stack-allocated",
+        11 => "npt-begin",
+        12 => "npt-ready",
+        13 => "npt-bypassed",
+        14 => "vmcb-control-ready",
+        15 => "vmcb-state-ready",
+        16 => "msrpm-configured",
+        17 => "vmcb-ready",
+        18 => "launch-validation",
+        19 => "vmrun-entered",
+        20 => "guest-returned",
+        21 => "virtualized",
+        22 => "launch-failed",
+        23 => "exception",
+        24 => "cleanup",
+        25 => "skipped",
+        _ => "unknown",
+    }
+}
+
+fn svm_validation_text(mask: u32) -> String {
+    const ITEMS: &[(u32, &str)] = &[
+        (0x00000001, "vmcb"),
+        (0x00000002, "host-save"),
+        (0x00000004, "msrpm"),
+        (0x00000008, "exit-stack"),
+        (0x00000010, "physical"),
+        (0x00000020, "alignment"),
+        (0x00000040, "asid"),
+        (0x00000080, "intercept1"),
+        (0x00000100, "intercept2"),
+        (0x00000200, "intercept3"),
+        (0x00000400, "vintr"),
+        (0x00000800, "cs"),
+        (0x00001000, "ss"),
+        (0x00002000, "tr"),
+        (0x00004000, "npt"),
+    ];
+    let mut names = Vec::new();
+    for (bit, name) in ITEMS {
+        if mask & bit != 0 {
+            names.push(*name);
+        }
+    }
+    if names.is_empty() {
+        "none".to_string()
+    } else {
+        names.join(",")
+    }
+}

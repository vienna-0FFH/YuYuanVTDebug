+static USHORT SvmSegmentAttributes(ULONG AccessRights)
+{
+    if ((AccessRights & 0x10000u) != 0) {
+        return 0;
+    }
+
+    return (USHORT)((AccessRights & 0xFFu) | ((AccessRights >> 4) & 0xF00u));
+}
+
+static VOID SvmSetSegment(
+    PSVM_SEGMENT_REGISTER Destination,
+    const SEGMENT_SELECTOR* Source,
+    ULONG64 Base)
+{
+    Destination->Selector = Source->Selector;
+    Destination->Attributes = SvmSegmentAttributes(Source->AccessRights);
+    Destination->Limit = Source->Limit;
+    Destination->Base = Base;
+}

+    Diagnostics->ProcessorCount = g_HypervisorContext.ProcessorCount;
+    Diagnostics->GlobalActive = g_HypervisorContext.IsActive ? 1 : 0;
+    Diagnostics->PowerOffline = HvIsPowerOffline() ? 1 : 0;
+    Diagnostics->SvmDebugFlag = g_SvmDebugFlag;
+    Diagnostics->SvmExitCounter = g_SvmExitCounter;
+    Diagnostics->SvmLastExitCode = g_SvmLastExitCode;
+    Diagnostics->SvmStartupRecordCount = s_SvmStartup.RecordCount;
+    Diagnostics->SvmStartupAttemptedCount = s_SvmStartup.AttemptedCount;
+    Diagnostics->SvmStartupReadyCount = s_SvmStartup.ReadyCount;
+    Diagnostics->SvmStartupFirstFailureCpu = s_SvmStartup.FirstFailureCpu;
+    Diagnostics->SvmStartupFirstFailurePhase = s_SvmStartup.FirstFailurePhase;
+    Diagnostics->SvmStartupFirstFailureStatus = s_SvmStartup.FirstFailureStatus;
+    Diagnostics->SvmStartupFirstFailureException = s_SvmStartup.FirstFailureException;
+    RtlCopyMemory(
+        Diagnostics->SvmStartup,
+        s_SvmStartup.Cpu,
+        sizeof(Diagnostics->SvmStartup));
+
+    if (vcpuData != NULL) {
+        for (processor = 0;
+             processor < Diagnostics->ProcessorCount;
+             ++processor) {
+            if (vcpuData[processor].IsVirtualized) {
+                Diagnostics->VirtualizedCount++;
+            }
+        }
+        if (currentProcessor < Diagnostics->ProcessorCount) {
+            Diagnostics->CurrentProcessorVirtualized =
+                vcpuData[currentProcessor].IsVirtualized ? 1 : 0;
+        }

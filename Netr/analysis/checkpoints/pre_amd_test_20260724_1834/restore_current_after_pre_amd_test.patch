+VOID HvLogInactiveDiagnostics(_In_z_ PCSTR Source, _In_ NTSTATUS Status)
+{
+    ULONG currentProcessor = KeGetCurrentProcessorNumber();
+    ULONG processorCount = g_HypervisorContext.ProcessorCount;
+    ULONG virtualizedCount = 0;
+    BOOLEAN currentProcessorVirtualized = FALSE;
+    PVCPU_DATA vcpuData = g_HypervisorContext.VcpuData;
+    CPU_VENDOR cpuVendor = HvGetCpuVendor();
+    int basicFeatures[4] = { 0 };
+    int maximumExtendedLeaf[4] = { 0 };
+    int svmFeatures[4] = { 0 };
+    int svmCapabilities[4] = { 0 };
+    ULONG64 efer = 0;
+    ULONG64 vmCr = 0;
+    ULONG64 hostSavePa = 0;
+    NTSTATUS amdMsrStatus = STATUS_SUCCESS;
+    BOOLEAN amdMsrReadable = FALSE;
+
+    if (InterlockedCompareExchange(&s_InactiveDiagnosticLogged, TRUE, FALSE) != FALSE) {
+        return;
+    }
+
+    s_LastInactiveStatus = Status;
+    KeMemoryBarrier();
+
+    KeMemoryBarrier();
+    if (vcpuData != NULL) {
+        for (ULONG processor = 0; processor < processorCount; ++processor) {
+            if (vcpuData[processor].IsVirtualized) {
+                virtualizedCount++;
+            }
+        }
+
+        if (currentProcessor < processorCount) {
+            currentProcessorVirtualized = vcpuData[currentProcessor].IsVirtualized;
+        }
+    }
+
+    __cpuid(basicFeatures, 1);
+    DbgPrint("[HV-DIAG] INACTIVE: source=%s status=0x%08X\n", Source, Status);
+    DbgPrint("[HV-DIAG] state: active=%u power_offline=%u vendor=%u current_cpu=%lu current_virtualized=%u virtualized=%lu/%lu vcpu=%p\n",
+             g_HypervisorContext.IsActive ? 1 : 0,
+             HvIsPowerOffline() ? 1 : 0,
+             (ULONG)cpuVendor,
+             currentProcessor,
+             currentProcessorVirtualized ? 1 : 0,
+             virtualizedCount,
+             processorCount,
+             vcpuData);
+    DbgPrint("[HV-DIAG] health_probe: reason=%lu result=0x%llX exception=0x%08X cpuid_1_ecx=0x%08X hypervisor_present=%u\n",
+             s_LastHealthProbeReason,
+             s_LastHealthProbeResult,
+             s_LastHealthProbeException,
+             (ULONG)basicFeatures[2],
+             ((ULONG)basicFeatures[2] & 0x80000000u) ? 1 : 0);
+
+    if (cpuVendor != CPU_VENDOR_AMD) {
+        return;
+    }
+
+    __cpuid(maximumExtendedLeaf, 0x80000000);
+    if ((ULONG)maximumExtendedLeaf[0] >= 0x80000001u) {
+        __cpuid(svmFeatures, 0x80000001);
+    }
+    if ((ULONG)maximumExtendedLeaf[0] >= 0x8000000Au) {
+        __cpuid(svmCapabilities, 0x8000000A);
+    }
+
+    __try {
+        efer = __readmsr(MSR_IA32_EFER);
+        vmCr = __readmsr(MSR_AMD_VM_CR);
+        hostSavePa = __readmsr(MSR_AMD_VM_HSAVE_PA);
+        amdMsrReadable = TRUE;
+    }
+    __except (EXCEPTION_EXECUTE_HANDLER) {
+        amdMsrStatus = GetExceptionCode();
+    }
+
+    DbgPrint("[HV-DIAG] amd_cpuid: max_ext=0x%08X svm_ecx=0x%08X svm_revision=0x%08X max_asid=%u features_edx=0x%08X\n",
+             (ULONG)maximumExtendedLeaf[0],
+             (ULONG)svmFeatures[2],
+             (ULONG)svmCapabilities[0],
+             (ULONG)svmCapabilities[1],
+             (ULONG)svmCapabilities[3]);
+    if (amdMsrReadable) {
+        DbgPrint("[HV-DIAG] amd_msr: efer=0x%llX svme=%u vm_cr=0x%llX lock=%u svmdis=%u hsave_pa=0x%llX\n",
+                 efer,
+                 (efer & EFER_SVME) ? 1 : 0,
+                 vmCr,
+                 (vmCr & VM_CR_LOCK) ? 1 : 0,
+                 (vmCr & VM_CR_SVMDIS) ? 1 : 0,
+                 hostSavePa);
+    }
+    else {
+        DbgPrint("[HV-DIAG] amd_msr: snapshot exception=0x%08X\n", amdMsrStatus);
+    }
+    DbgPrint("[HV-DIAG] amd_launch: asm_flag=0x%llX vmexit_count=%llu last_exit=0x%llX\n",
+             g_SvmDebugFlag,
+             g_SvmExitCounter,
+             g_SvmLastExitCode);
+}

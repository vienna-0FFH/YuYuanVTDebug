+    case HvSvmStartPhaseSvmeEnabled:
+        return HV_SVM_START_FLAG_SVME_ENABLED;
+    case HvSvmStartPhaseHostSaveAllocated:
+        return HV_SVM_START_FLAG_HOSTSAVE_ALLOCATED;
+    case HvSvmStartPhaseVmcbAllocated:
+        return HV_SVM_START_FLAG_VMCB_ALLOCATED;
+    case HvSvmStartPhaseMsrpmAllocated:
+        return HV_SVM_START_FLAG_MSRPM_ALLOCATED;
+    case HvSvmStartPhaseExitStackAllocated:
+        return HV_SVM_START_FLAG_EXIT_STACK_ALLOCATED;
+    case HvSvmStartPhaseNptBegin:
+        return HV_SVM_START_FLAG_NPT_ATTEMPTED;
+    case HvSvmStartPhaseNptReady:
+        return HV_SVM_START_FLAG_NPT_READY;
+    case HvSvmStartPhaseNptBypassed:
+        return HV_SVM_START_FLAG_NPT_BYPASSED;
+    case HvSvmStartPhaseVmcbReady:
+        return HV_SVM_START_FLAG_VMCB_READY;
+    case HvSvmStartPhaseLaunchValidation:
+        return HV_SVM_START_FLAG_LAUNCH_VALIDATED;
+    case HvSvmStartPhaseVmrunEntered:
+        return HV_SVM_START_FLAG_VMRUN_ENTERED;
+    case HvSvmStartPhaseGuestReturned:
+        return HV_SVM_START_FLAG_GUEST_RETURNED;
+    case HvSvmStartPhaseVirtualized:
+        return HV_SVM_START_FLAG_VIRTUALIZED;
+    case HvSvmStartPhaseCleanup:
+        return HV_SVM_START_FLAG_CLEANUP;
+    default:
+        return 0;
+    }
+}
+
+VOID HvSvmStartupDiagnosticsReset(_In_ ULONG ProcessorCount)
+{
+    ULONG recordCount = min(ProcessorCount, HV_SVM_STARTUP_DIAGNOSTIC_MAX_CPUS);
+
+    RtlZeroMemory(&s_SvmStartup, sizeof(s_SvmStartup));
+    s_SvmStartup.RecordCount = recordCount;
+    s_SvmStartup.FirstFailureCpu = MAXULONG;
+    s_SvmStartup.FirstFailureStatus = STATUS_SUCCESS;
+
+    for (ULONG processor = 0; processor < recordCount; ++processor) {
+        s_SvmStartup.Cpu[processor].RequestedProcessor = processor;
+        s_SvmStartup.Cpu[processor].ActualProcessor = MAXULONG;
+        s_SvmStartup.Cpu[processor].LastStatus = STATUS_DEVICE_NOT_READY;
+        s_SvmStartup.Cpu[processor].FailureStatus = STATUS_SUCCESS;
+    }
+
+    KeMemoryBarrier();
+}
+
+VOID HvSvmStartupRecord(
+    _In_ ULONG RequestedProcessor,
+    _In_ ULONG ActualProcessor,
+    _In_ HV_SVM_START_PHASE Phase,
+    _In_ NTSTATUS Status,
+    _In_ BOOLEAN Fatal)
+{
+    PHV_SVM_CPU_STARTUP_DIAGNOSTIC record;
+    ULONG phaseFlag;
+    ULONG previousFlags;
+
+    if (RequestedProcessor >= s_SvmStartup.RecordCount ||
+        RequestedProcessor >= HV_SVM_STARTUP_DIAGNOSTIC_MAX_CPUS) {
+        return;
+    }
+
+    record = &s_SvmStartup.Cpu[RequestedProcessor];
+    phaseFlag = HvpSvmStartupPhaseFlag(Phase);
+    previousFlags = record->Flags;
+
+    if (ActualProcessor != MAXULONG) {
+        record->ActualProcessor = ActualProcessor;
+    }
+    record->LastPhase = (ULONG)Phase;
+    record->LastStatus = Status;
+    record->Flags |= phaseFlag;
+
+    if (Phase == HvSvmStartPhaseAffinityRequested &&
+        (previousFlags & HV_SVM_START_FLAG_AFFINITY_REQUESTED) == 0) {
+        s_SvmStartup.AttemptedCount++;
+    }
+    if (Phase == HvSvmStartPhaseVirtualized &&
+        (previousFlags & HV_SVM_START_FLAG_VIRTUALIZED) == 0) {
+        s_SvmStartup.ReadyCount++;
+    }
+
+    if (Fatal && record->FailurePhase == HvSvmStartPhaseNone) {
+        record->FailurePhase = (ULONG)Phase;
+        record->FailureStatus = Status;
+
+        if (s_SvmStartup.FirstFailureCpu == MAXULONG) {
+            s_SvmStartup.FirstFailureCpu = RequestedProcessor;
+            s_SvmStartup.FirstFailurePhase = (ULONG)Phase;
+            s_SvmStartup.FirstFailureStatus = Status;
+        }
+    }
+
+    KeMemoryBarrier();
+}
+
+VOID HvSvmStartupRecordVcpu(
+    _In_ PVCPU_DATA VcpuData,
+    _In_ HV_SVM_START_PHASE Phase,
+    _In_ NTSTATUS Status,
+    _In_ BOOLEAN Fatal)
+{
+    PHV_SVM_CPU_STARTUP_DIAGNOSTIC record;
+    ULONG processor;
+
+    if (VcpuData == NULL) {
+        return;
+    }
+
+    processor = VcpuData->ProcessorNumber;
+    HvSvmStartupRecord(processor, processor, Phase, Status, Fatal);
+    if (processor >= s_SvmStartup.RecordCount) {
+        return;
+    }
+
+    record = &s_SvmStartup.Cpu[processor];
+    record->HostSavePa = (ULONG64)VcpuData->HostSaveAreaPhysical.QuadPart;
+    record->VmcbPa = (ULONG64)VcpuData->VmcbPhysical.QuadPart;
+    record->MsrpmPa = (ULONG64)VcpuData->MsrPermissionMapPhysical.QuadPart;
+    record->Ncr3 = (VcpuData->NptTables != NULL)
+        ? (ULONG64)VcpuData->NptTables->Pml4Physical.QuadPart
+        : 0;
+    record->VmcbExitCode = (VcpuData->Vmcb != NULL)
+        ? VcpuData->Vmcb->ControlArea.ExitCode
+        : 0;
+    record->AsmDebugFlag = g_SvmDebugFlag;
+    KeMemoryBarrier();
+}
+
+VOID HvSvmStartupRecordMsrs(
+    _In_ PVCPU_DATA VcpuData,
+    _In_ ULONG64 Efer,
+    _In_ ULONG64 VmCr)
+{
+    ULONG processor;
+
+    if (VcpuData == NULL) {
+        return;
+    }
+
+    processor = VcpuData->ProcessorNumber;
+    if (processor >= s_SvmStartup.RecordCount) {
+        return;
+    }
+
+    s_SvmStartup.Cpu[processor].Efer = Efer;
+    s_SvmStartup.Cpu[processor].VmCr = VmCr;
+    KeMemoryBarrier();
+}
+
+VOID HvSvmStartupRecordLaunchValidation(
+    _In_ PVCPU_DATA VcpuData,
+    _In_ ULONG ValidationMask)
+{
+    ULONG processor;
+
+    if (VcpuData == NULL) {
+        return;
+    }
+
+    processor = VcpuData->ProcessorNumber;
+    if (processor >= s_SvmStartup.RecordCount) {
+        return;
+    }
+
+    s_SvmStartup.Cpu[processor].LaunchValidationMask = ValidationMask;
+    KeMemoryBarrier();
+}
+
+VOID HvSvmStartupRecordSsState(
+    _In_ PVCPU_DATA VcpuData,
+    _In_ ULONG SsSelector,
+    _In_ ULONG SsAccessRights,
+    _In_ ULONG SsVmcbAttributes,
+    _In_ ULONG SsFlags)
+{
+    ULONG processor;
+
+    if (VcpuData == NULL) {
+        return;
+    }
+
+    processor = VcpuData->ProcessorNumber;
+    if (processor >= s_SvmStartup.RecordCount) {
+        return;
+    }
+
+    s_SvmStartup.Cpu[processor].SsSelector = SsSelector;
+    s_SvmStartup.Cpu[processor].SsAccessRights = SsAccessRights;
+    s_SvmStartup.Cpu[processor].SsVmcbAttributes = SsVmcbAttributes;
+    s_SvmStartup.Cpu[processor].SsFlags = SsFlags;
+    KeMemoryBarrier();
+}
+
+VOID HvSvmStartupRecordException(
+    _In_ ULONG RequestedProcessor,
+    _In_ ULONG ActualProcessor,
+    _In_ NTSTATUS ExceptionCode)
+{
+    PHV_SVM_CPU_STARTUP_DIAGNOSTIC record = NULL;
+    ULONG failurePhase = (ULONG)HvSvmStartPhaseException;
+
+    if (RequestedProcessor < s_SvmStartup.RecordCount) {
+        record = &s_SvmStartup.Cpu[RequestedProcessor];
+        if (record->LastPhase != HvSvmStartPhaseNone) {
+            failurePhase = record->LastPhase;
+        }
+        if (record->FailurePhase == HvSvmStartPhaseNone) {
+            record->FailurePhase = failurePhase;
+            record->FailureStatus = ExceptionCode;
+        }
+        record->ExceptionCode = (ULONG)ExceptionCode;
+    }
+
+    if (s_SvmStartup.FirstFailureCpu == MAXULONG) {
+        s_SvmStartup.FirstFailureCpu = RequestedProcessor;
+        s_SvmStartup.FirstFailurePhase = failurePhase;
+        s_SvmStartup.FirstFailureStatus = ExceptionCode;
+        s_SvmStartup.FirstFailureException = (ULONG)ExceptionCode;
+    }
+
+    HvSvmStartupRecord(
+        RequestedProcessor,
+        ActualProcessor,
+        HvSvmStartPhaseException,
+        ExceptionCode,
+        FALSE);
+    KeMemoryBarrier();
+}
 

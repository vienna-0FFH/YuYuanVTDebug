+VOID SvmDisableOnCpu(VOID)
+{
+    ULONG64 efer;
+
+    __try {
+        efer = __readmsr(MSR_IA32_EFER);
+        if ((efer & EFER_SVME) != 0) {
+            AsmStgi();
+            __writemsr(MSR_AMD_VM_HSAVE_PA, 0);
+            __writemsr(MSR_IA32_EFER, efer & ~EFER_SVME);
+        }
+    }
+    __except (EXCEPTION_EXECUTE_HANDLER) {
+    }
+}
 

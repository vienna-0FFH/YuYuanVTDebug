-static __forceinline VOID
-NptHookpArmGuestSingleStepState(
-    _In_ PVCPU_DATA VcpuData,
-    _Out_ PBOOLEAN GuestTfWasSet,
-    _Out_ PBOOLEAN GuestIfWasSet,
-    _Out_ PBOOLEAN DbInterceptWasSet)
-{
-    ULONG64 rflags = VcpuData->Vmcb->StateSaveArea.Rflags;
-
-    *GuestTfWasSet = (rflags & NPT_GUEST_RFLAGS_TF) != 0;
-    *GuestIfWasSet = (rflags & NPT_GUEST_RFLAGS_IF) != 0;
-    *DbInterceptWasSet =
-        (VcpuData->Vmcb->ControlArea.InterceptExceptions &
-         NPT_DB_INTERCEPT_MASK) != 0;
-
-    /* A real TF window must not be crossed by a schedulable guest interrupt.
-     * Otherwise Windows can save TF in an interrupt frame, migrate that
-     * thread, and resume it on a CPU that does not own this #DB intercept. */
-    VcpuData->Vmcb->StateSaveArea.Rflags =
-        (rflags | NPT_GUEST_RFLAGS_TF) & ~NPT_GUEST_RFLAGS_IF;
-    VcpuData->Vmcb->ControlArea.InterceptExceptions |=
-        NPT_DB_INTERCEPT_MASK;
-    VcpuData->Vmcb->ControlArea.VmcbCleanBits = 0;
-}
-
-static __forceinline BOOLEAN
-NptHookpRestoreGuestSingleStepState(
-    _In_ PVCPU_DATA VcpuData,
-    _In_ BOOLEAN GuestTfWasSet,
-    _In_ BOOLEAN GuestIfWasSet,
-    _In_ BOOLEAN DbInterceptWasSet)
-{
-    ULONG64 rflags = VcpuData->Vmcb->StateSaveArea.Rflags;
-    BOOLEAN reinject = FALSE;
-
-    rflags &= ~NPT_GUEST_RFLAGS_TF;
-    if (GuestTfWasSet) {
-        rflags |= NPT_GUEST_RFLAGS_TF;
-        reinject = TRUE;
-    }
-    if (GuestIfWasSet) {
-        rflags |= NPT_GUEST_RFLAGS_IF;
-    }
-    VcpuData->Vmcb->StateSaveArea.Rflags = rflags;
-
-    if (DbInterceptWasSet) {
-        VcpuData->Vmcb->ControlArea.InterceptExceptions |=
-            NPT_DB_INTERCEPT_MASK;
-    } else {
-        VcpuData->Vmcb->ControlArea.InterceptExceptions &=
-            ~NPT_DB_INTERCEPT_MASK;
-    }
-    VcpuData->Vmcb->ControlArea.VmcbCleanBits = 0;
-
-    if ((VcpuData->Vmcb->StateSaveArea.Dr6 &
-         NPT_DR6_NON_SYNTHETIC_CAUSE_MASK) != 0) {
-        reinject = TRUE;
-    }
-    return reinject;
-}
-
 #define NPT_HOOK_ROOT_ACQUIRE_RETRIES 8
 #define NPT_HOOK_DRAIN_RETRIES        200
 
@@ -1278,6 +1211,10 @@ BOOLEAN NptHookHandleDebugStepNpf(
     trap.Value = match->OriginalPteValue[cpu];
     trap.NoExecute = 1;
     stepCpu->Deliver = deliver;

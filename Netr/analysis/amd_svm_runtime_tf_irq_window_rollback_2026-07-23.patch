-#define NPT_DB_INTERCEPT_MASK            (1ULL << 1)
-#define NPT_DR6_BS_MASK                  (1ULL << 14)
-#define NPT_DR6_NON_SYNTHETIC_CAUSE_MASK 0xB00FULL
-
 typedef struct _NPT_DEBUG_STEP_ENTRY {
     volatile LONG State;
     volatile LONG Sequence;
@@ -76,8 +70,8 @@ typedef struct _NPT_DEBUG_STEP_CPU {
     volatile LONG Active;
     BOOLEAN Deliver;
     BOOLEAN GuestTfWasSet;
-    BOOLEAN GuestIfWasSet;

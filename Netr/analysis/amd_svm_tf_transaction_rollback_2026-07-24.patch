     mov     rax, [rsp + VCPU_DATA_OFFSET]  ; RAX = VcpuData
+    cmp     DWORD PTR [rax + VCPU_SVM_STEP_BLOCK_IRQ], 0
+    jne     SvmExitResumeBlockInterrupts
     mov     rax, [rax + VCPU_VMCB_PHYSICAL] ; RAX = VmcbPhysical
 

+; TF single-step window: V_INTR_MASKING uses the host IF captured by VMRUN.
+SvmExitResumeBlockInterrupts:
+    mov     rax, [rax + VCPU_VMCB_PHYSICAL]
+    cli
+    vmrun   rax
+    jmp     SvmAfterVmrun
+
 ; === 终止虚拟化 ===

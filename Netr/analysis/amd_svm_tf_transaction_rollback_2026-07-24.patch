 VCPU_HOST_SAVE_PHYSICAL EQU 0A0h    ; PHYSICAL_ADDRESS HostSaveAreaPhysical
+VCPU_SVM_STEP_BLOCK_IRQ EQU 940h    ; volatile LONG SvmSingleStepBlockInterrupts
 
 VMCB_EXIT_CODE          EQU 070h
 VMCB_EXIT_INFO1         EQU 078h
